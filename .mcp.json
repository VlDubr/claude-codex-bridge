{
  "mcpServers": {
    "codex": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp-codex.mjs"
      ],
      "env": {
        "TANDEM_REVIEW_BACKEND": "${user_config.review_backend}",
        "TANDEM_LANG": "${user_config.language}",
        "TANDEM_MODEL": "${user_config.default_model}",
        "TANDEM_EFFORT": "${user_config.default_effort}",
        "TANDEM_REASONING_SUMMARY": "${user_config.reasoning_summary}",
        "TANDEM_JOB_TIMEOUT_MIN": "${user_config.job_timeout_minutes}",
        "TANDEM_MAX_PARALLEL_JOBS": "${user_config.max_parallel_jobs}",
        "TANDEM_BYPASS_SANDBOX": "${user_config.bypass_sandbox}",
        "TANDEM_PROGRESS": "${user_config.progress_notifications}"
      }
    },
    "image": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp-image.mjs"
      ],
      "env": {
        "TANDEM_LANG": "${user_config.language}",
        "TANDEM_IMAGE_DIR": "${user_config.image_output_dir}",
        "TANDEM_IMAGE_TIMEOUT_MIN": "${user_config.image_timeout_minutes}",
        "TANDEM_BYPASS_SANDBOX": "${user_config.bypass_sandbox}",
        "TANDEM_PROGRESS": "${user_config.progress_notifications}"
      }
    }
  }
}
